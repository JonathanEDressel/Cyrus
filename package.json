{
  "name": "cyrus",
  "version": "1.2.9",
  "author": "Jonathan Dressel <jonathanedressel@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Automated trades and transfers for crypto exchanges",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "start:all": "node scripts/dev.js",
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "npm run build && electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:backend": "cd src/backend && ..\\..\\venv\\Scripts\\python.exe -m PyInstaller server.spec --noconfirm",
    "build:all": "npm run build && npm run build:backend && npm run dist"
  },
  "build": {
    "appId": "com.cyrus.app",
    "productName": "Cyrus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/index.html",
      "src/donation.js",
      "src/app/**/*",
      "src/assets/**/*",
      "!src/**/*.ts",
      "!src/backend/**/*"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "src/backend/dist/CyrusServer.exe",
          "to": "backend/CyrusServer.exe"
        }
      ]
    },
    "afterPack": "scripts/mac-adhoc-sign.js",
    "mac": {
      "icon": "src/assets/mac/icon.png",
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "Cyrus-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "src/backend/dist/CyrusServer",
          "to": "backend/CyrusServer"
        }
      ]
    },
    "dmg": {
      "title": "Cyrus ${version}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "44.11.3",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "html-to-image": "^1.11.13",
    "lightweight-charts": "^5.1.0"
  }
}
